# SkillEscrow backend (Rust). Copy to `.env`, fill in, then run `escrowd doctor`.
# Variable names match the original TypeScript API, so an existing .env keeps working.
# Never commit a real .env. Secrets belong in your host's secret store.

# ---- core ---------------------------------------------------------------------------------
PORT=3001
LOG_LEVEL=info                      # or e.g. info,escrow_engine=debug
LOG_FORMAT=pretty                   # `json` for log shippers
DATABASE_URL=postgres://escrow:escrow@localhost:5432/escrow
# AUTO_MIGRATE=true                 # apply migrations at start-up (set false to run `escrowd migrate` yourself)
# DB_MAX_CONNECTIONS=10

# ---- Stellar / Soroban ----------------------------------------------------------------------
STELLAR_NETWORK=testnet             # testnet | mainnet | local
# STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
BOUNTY_CONTRACT_ID=C...             # the deployed escrow contract (see escrow-contracts/deployments/)
# Token contracts bounties can be paid in. Leave one empty to disable that token.
TOKEN_XLM_CONTRACT_ID=
TOKEN_USDC_CONTRACT_ID=
# Per-bounty limits in whole tokens (the contract enforces its own, authoritative ones).
# TOKEN_MIN_AMOUNT=1
# TOKEN_MAX_AMOUNT=500
# MIN_DAYS=1
# MAX_DAYS=90
# INDEXER_START_LEDGER=             # first run: the contract's deployment ledger (else: tip minus lookback)
# INDEXER_LOOKBACK_LEDGERS=1000
# INDEXER_INTERVAL_SECS=5

# ---- URLs and secrets -----------------------------------------------------------------------
API_PUBLIC_URL=http://localhost:3001   # must be https in production (cookies become Secure)
WEB_PUBLIC_URL=http://localhost:3000
# Generate each with:  openssl rand -hex 32
SESSION_SECRET=
CSRF_SECRET=
GITHUB_WEBHOOK_SECRET=
# TRUST_PROXY=1                     # only behind a reverse proxy you control: believe X-Forwarded-For
# METRICS_TOKEN=                    # require `Authorization: Bearer <token>` on /metrics

# ---- GitHub App (docs/GITHUB_APP.md in the app repo). All five or none. -------------------------
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=             # the PEM; literal \n is accepted
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_IDS=                   # comma-separated numeric GitHub user ids allowed to use the dispute tools

# ---- relayer (automatic payouts) ---------------------------------------------------------------
# A funded TESTNET secret key (S...). Refused on mainnet: use a KMS-backed signer there.
RELAYER_SECRET=
# RELAYER_MIN_XLM_ALERT=50
# ALERT_WEBHOOK_URL=                # Slack/Discord-style webhook that receives alert text

# ---- AI review (optional; advisory only, never affects payouts) -------------------------------
ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
# AI_MAX_REVIEWS_PER_PR_PER_DAY=5
# AI_MAX_REVIEWS_PER_REPO_PER_DAY=50
# REVIEW_DEBOUNCE_SECS=300

# ---- worker ------------------------------------------------------------------------------------
# WORKER_CONCURRENCY=4
# EXPLORER_TX_URL_TEMPLATE=https://stellar.expert/explorer/testnet/tx/{hash}
